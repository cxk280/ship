{
  "name": "@ship/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript SDK for the Ship public API (Plugforge).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "fast-check": "^4.8.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  }
}
