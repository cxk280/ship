# Ship ↔ GitHub bridge — copy to .env and fill in. NEVER commit real secrets.

# HTTP port the bridge listens on.
PORT=4100

# Public base URL this server is reachable at (no trailing path).
# Used to build the Ship webhook target (PUBLIC_URL/webhooks/ship) AND is the base
# for the GitHub webhook you register (PUBLIC_URL/webhooks/github).
# Leave empty to skip Ship auto-subscription (then set SHIP_WEBHOOK_SECRET).
PUBLIC_URL=https://your-tunnel.ngrok.io

# ---- Ship ----
SHIP_BASE_URL=http://localhost:3000
SHIP_CLIENT_ID=ship_app_cli
# SHIP_CLIENT_SECRET=                      # set → client_credentials; unset → device flow
SHIP_SCOPES=issues:read issues:write documents:write webhooks:manage
# Ship events to mirror to GitHub.
SHIP_EVENTS=issue.created,issue.status_changed
# Optional: verify deliveries from an externally-managed subscription.
# SHIP_WEBHOOK_SECRET=whsec_...

# ---- GitHub ----
# PAT (classic with `repo`, or fine-grained with Issues: read & write).
GITHUB_TOKEN=ghp_xxx
# Target repository for mirrored issues.
GITHUB_REPO=your-org/your-repo
# Shared secret configured on the GitHub webhook (X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET=replace-with-a-strong-random-string
# Override for GitHub Enterprise.
# GITHUB_API_BASE=https://api.github.com

# Optional overrides for token / secret cache locations.
# SHIP_TOKEN_FILE=~/.ship/github-bridge.json
# SHIP_WEBHOOK_SECRET_FILE=~/.ship/github-bridge-secret.json
