{
  "name": "@ship/github-integration",
  "version": "0.1.0",
  "description": "Ship ↔ GitHub bridge: mirrors Ship issues to GitHub and links GitHub PRs back to Ship issues.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ship/sdk": "workspace:*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  }
}
