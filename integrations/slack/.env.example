# Ship → Slack bridge — copy to .env and fill in. NEVER commit real secrets.

# HTTP port the bridge listens on.
PORT=4000

# Public base URL Ship should deliver webhooks to (NO trailing path).
# In local dev, expose PORT with a tunnel (ngrok/cloudflared) and paste its URL.
# Leave empty to skip auto-subscription and manage the subscription yourself.
PUBLIC_URL=https://your-tunnel.ngrok.io

# Ship API origin.
SHIP_BASE_URL=http://localhost:3000

# OAuth client. If SHIP_CLIENT_SECRET is set → client_credentials (machine app).
# If only SHIP_CLIENT_ID is set → Device Authorization Grant on first run.
SHIP_CLIENT_ID=ship_app_cli
# SHIP_CLIENT_SECRET=

# Scopes requested in device flow (client_credentials uses the app's granted scopes).
SHIP_SCOPES=documents:read webhooks:manage

# Comma-separated Ship events to subscribe to.
SHIP_EVENTS=document.created,issue.created

# Slack Incoming Webhook URL. If unset, messages are logged instead of posted.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional: verify deliveries from an externally-managed subscription instead of
# auto-subscribing. Used when PUBLIC_URL is empty.
# SHIP_WEBHOOK_SECRET=whsec_...

# Optional overrides for where the device token / signing secrets are cached.
# SHIP_TOKEN_FILE=~/.ship/slack-bridge.json
# SHIP_WEBHOOK_SECRET_FILE=~/.ship/slack-bridge-secret.json
